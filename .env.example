# --- PostgreSQL ---
POSTGRES_USER=promo
POSTGRES_PASSWORD=promo
POSTGRES_DB=promo

# URL для бэкенда (host = имя сервиса db в compose-сети)
DATABASE_URL=postgresql+psycopg://promo:promo@db:5432/promo

# --- JWT ---
JWT_SECRET=dev-secret-change-me-in-prod
JWT_EXPIRE_MINUTES=10080

# --- Логика статусов ---
# Окно агрегации отчётов, часов
STATUS_WINDOW_HOURS=24
# Кулдаун между отчётами одного пользователя по одной паре (ресторан, акция), минут
REPORT_COOLDOWN_MINUTES=30
# Один общий интервал между заявками на акции и рестораны
SUGGESTION_COOLDOWN_MINUTES=15
# Мягкие ограничения для жалоб и голосов за промокоды
# ISSUE_COOLDOWN_MINUTES=5
# PROMO_CODE_VOTE_COOLDOWN_SECONDS=60

# --- Доверие и рейтинг (docs/trust-and-rating-spec.md) ---
# Все константы имеют дефолты в backend/app/config.py и переопределяются здесь
# при необходимости, например:
# TRUTH_HALF_LIFE_HOURS=3       # полураспад накопленных лог-шансов
# TRUTH_K_RECEIPT=3.0           # вес «есть», подтверждённого чеком
# TRUTH_CEILING_BASE=2.6        # потолок уверенности на тихой точке
# TRUTH_P_AVAILABLE=0.85        # порог уверенного «есть»
# TRUTH_P_UNAVAILABLE=0.15      # порог уверенного «кончилось»
# NOTIFY_DWELL_MINUTES=10       # выдержка статуса перед уведомлением бота
# NOTIFY_COOLDOWN_MINUTES=20    # пауза между уведомлениями по паре
# FLIP_RATIO=1.5                # перевес массы для консенсуса вердикта
# VERDICT_MATURE_HOURS=12       # дозревание вердикта отчёта
# TRUST_JOB_INTERVAL_SECONDS=300  # период фонового пересчёта (0 — выключить)

# --- Промокоды (docs/promo-codes-spec.md) ---
# PROMO_CODE_TTL_DAYS=5             # столько живёт код без подтверждений
# PROMO_CODE_TTL_FLOOR_HOURS=12     # пол продления при повторах одного человека
# PROMO_CODE_FAIL_VOTES=2           # столько разных жалоб убивают код
# PROMO_CODE_AUTHOR_POINTS=5        # автору, один раз за жизнь кода

# --- Прод ---
# Число воркеров uvicorn в прод-режиме (по умолчанию 2)
# UVICORN_WORKERS=2

# --- Telegram ---
# Токен бота (@BotFather): включает вход через Telegram WebApp, уведомления
# о подписках и подтверждение номера. Пусто — телеграм-функции выключены.
TELEGRAM_BOT_TOKEN=
# Бот слушает сообщения (подтверждение номера отправкой контакта)
# TELEGRAM_POLLING_ENABLED=true
# Требовать подтверждённый номер для отчётов/заявок/подписок (прод-режим
# анти-спама; локально держите false)
# REQUIRE_PHONE_VERIFICATION=false

# --- Игровой режим: захват точек фракциями (docs/game-mode-spec.md) ---
# Выключатель фичи на весь сервис: false — режим недоступен, интерфейс
# и данные ровно как без него
# GAME_ENABLED=true
# Период фонового прохода по шкалам захвата, секунд (0 — выключить)
# GAME_JOB_INTERVAL_SECONDS=60
# Остальные константы имеют дефолты в backend/app/config.py, например:
# RECEIPT_MIN_SUM_KOPEKS=5000       # минимальная сумма чека, копеек
# RECEIPT_MAX_AGE_MINUTES=30        # окно от кассы до выдачи заказа
# CAPTURE_GEO_RADIUS_M=800          # радиус приёма чека от обычного пользователя
# CAPTURE_REQUIRE_GEO=true          # локально можно выключить гео-проверку
# CAPTURE_HALF_LIFE_HOURS=72        # полураспад силы фракции (у обеих сторон)
# CAPTURE_BAR_SECONDS=14400         # шкала захвата при равной силе, секунд
# FACTION_JOIN_BLOCK_SHARE=0.6      # доля, при которой набор во фракцию закрыт

# --- Сиды ---
# При старте бэкенда: если таблица users пуста — прогнать сиды
SEED_ON_START=true

# --- Права на файлы в bind-mount ---
# id вашего пользователя на хосте (id -u / id -g)
UID=1000
GID=1000

# --- Vite dev proxy ---
VITE_API_PROXY_TARGET=http://backend:8000
